<?xml version="1.0"?>
<extension key="com.jasontdc.secondlastname" type="module">
  <file>secondlastname</file>
  <name>Second Last Name Extension</name>
  <description>Adds a Second Last Name field to the basic contact information.</description>
  <license>MIT</license>
  <maintainer>
    <author>Jason Davies</author>
    <email>jasontdc@gmail.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/jasontdc/com.jasontdc.secondlastname</url>
    <url desc="Documentation">https://github.com/jasontdc/com.jasontdc.secondlastname</url>
    <url desc="Support">https://github.com/jasontdc/com.jasontdc.secondlastname</url>
    <url desc="Licensing">https://opensource.org/licenses/MIT</url>
  </urls>
  <releaseDate>2016-12-19</releaseDate>
  <version>0.1</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.59</ver>
  </compatibility>
  <comments>This is a new, undeveloped module</comments>
  <civix>
    <namespace>CRM/Secondlastname</namespace>
    <format>26.10.3</format>
  </civix>
  <mixins>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Secondlastname\AutomaticUpgrader</upgrader>
</extension>
